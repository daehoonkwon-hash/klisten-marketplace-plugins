                "source_loss_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "claimedAmountRaw": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "currencyRaw": {
                  "type": "string",
                  "minLength": 1
                },
                "dateRaw": {
                  "type": "string",
                  "minLength": 1
                },
                "paidAmountRaw": {
                  "type": "string",
                  "maxLength": 100
                },
                "reserveRaw": {
                  "type": "string",
                  "maxLength": 100
                },
                "recoveryAmountRaw": {
                  "type": "string",
                  "maxLength": 100
                },
                "note": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "source_loss_id",
                "claimedAmountRaw",
                "currencyRaw",
                "dateRaw"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "carrier",
          "policy_ref",
          "period_label",
          "claims"
        ],
        "additionalProperties": false
      },
      "transportEnvelopeVerified": false,
      "executionClass": "stateful"
